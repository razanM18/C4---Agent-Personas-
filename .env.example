# Copy this file to .env and fill in the keys you have. Never upload the real .env.
GROQ_API_KEY=your-groq-key-here            # free at console.groq.com (main model: qwen/qwen3.8-27b)
GEMINI_API_KEY=your-gemini-key-here        # optional (model-type experiment, chat fallback)
# GEMINI_API_KEY_2=your-second-gemini-key   # optional: a different Google project, its own daily quota
# GEMINI_API_KEY_3=your-third-gemini-key
OPENROUTER_API_KEY=your-openrouter-key-here  # optional (model-type and top-k experiments)

# Optional settings (defaults shown)
# C4_PROVIDER=groq
# C4_MODEL=qwen/qwen3.8-27b
# C4_FALLBACKS=gemini,gemini2,gemini3,openrouter   # used only by the chat app, never by the pinned experiments
# C4_TIMEOUT=40                      # seconds before a hung request is abandoned
# VERBOSE=0
